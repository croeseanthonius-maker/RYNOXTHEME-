<nav class="mainNav" style="--logo-bg: {{ section.settings.background_color | default: '#ffffff' }}; --logo-color: {{ section.settings.text_color | default: '#313131' }}; --logo-padding: {{ section.settings.padding_horizontal | default: 24 }}px;">
  <a href="{{ routes.root_url }}" class="mainNav__logo">
    {% if settings.logo != blank %}
      {{ settings.logo | image_url: width: 200 | image_tag: class: 'mainNav__logo-image', alt: shop.name }}
      <span class="mainNav__logo-text">{{ shop.name }}</span>
    {% else %}
      {{ shop.name }}
    {% endif %}
  </a>
  
  <div class="mainNav__links">
    {% if section.settings.menu %}
      {% for link in linklists[section.settings.menu].links %}
        <div class="mainNav__link-wrapper">
          <a href="{{ link.url }}" class="mainNav__link">
            {{ link.title }}
            {% if link.links.size > 0 %}
              <svg class="mainNav__dropdown-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            {% endif %}
          </a>
          {% if link.links.size > 0 %}
            <div class="mainNav__megamenu">
              <div class="mainNav__megamenu-content">
                {% for sublink in link.links %}
                  <div class="mainNav__megamenu-column">
                    <a href="{{ sublink.url }}" class="mainNav__megamenu-title">{{ sublink.title }}</a>
                    {% if sublink.links.size > 0 %}
                      <ul class="mainNav__megamenu-list">
                        {% for childlink in sublink.links %}
                          <li><a href="{{ childlink.url }}" class="mainNav__megamenu-link">{{ childlink.title }}</a></li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </div>
  
  <div class="mainNav__actions">
    <a href="#" class="mainNav__action-link" id="searchToggleBtn" title="{{ 'general.search.search' | t }}" aria-label="{{ 'general.search.toggle_search' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
    </a>
    
    <a href="{{ routes.account_url }}" class="mainNav__action-link" title="{{ 'customer.account.title' | t }}" aria-label="{{ 'customer.account.title' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </a>
    <a href="{{ routes.cart_url }}" class="mainNav__action-link mainNav__cart" title="{{ 'cart.general.title' | t }}" aria-label="{{ 'cart.general.title' | t }}">
      <div class="mainNav__cart-count cart-count">{{ cart.item_count }}</div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
    </a>

    <a href="#" class="mainNav__icon" id="mobileMenuToggle" aria-label="Toggle menu" aria-expanded="false" role="button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </a>
  </div>

  <div class="mainNav__search-dropdown" id="searchDropdown">
    <div class="mainNav__search-wrapper">
      {% render 'glass-search' %}
    </div>
  </div>
</nav>

{% stylesheet %}
  body { padding-top: 56px; }
  .mainNav { width: 100vw; margin-left: calc(-50vw + 50%); height: 56px; position: fixed; top: 0; left: 0; z-index: 100; display: flex; justify-content: space-between; align-items: center; color: var(--logo-color); text-transform: uppercase; padding: 0 var(--logo-padding); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(255, 255, 255, 0.15) !important; border-bottom: 1px solid rgba(255, 255, 255, 0.3) !important; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.18) !important; }
  .mainNav__search-dropdown { position: absolute; top: 100%; left: 0; width: 100%; padding: 20px; background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border-bottom: 1px solid rgba(255, 255, 255, 0.4); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); z-index: 99; }
  .mainNav__search-dropdown.is-active { opacity: 1; visibility: visible; transform: translateY(0); }
  .mainNav__search-wrapper { max-width: 600px; margin: 0 auto; }
  
  a:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--logo-color); outline-offset: 4px; border-radius: 4px; }

  @media screen and (max-width: 799px) { 
    .mainNav { padding: 0 12px; } 
    .mainNav__search-dropdown { padding: 15px; } 
    .mainNav__actions { gap: 12px !important; }
  }
  
  .mainNav__logo { font-weight: 800; letter-spacing: 1px; font-size: 18px; color: #000000 !important; flex-shrink: 0; text-decoration: none !important; cursor: pointer; transition: color 0.3s ease; display: flex; align-items: center; }
  .mainNav__logo:hover { opacity: 0.8; text-decoration: none !important; }
  .mainNav__logo-image { max-height: 40px; width: auto; display: block; }
  .mainNav__logo-text { margin-left: 12px; font-weight: 800; letter-spacing: 2px; font-size: 18px; }
  
  .mainNav__links { display: flex; gap: 0; flex: 1; justify-content: center; align-items: center; }
  @media screen and (max-width: 799px) { .mainNav__links { display: none; } }
  
  .mainNav__actions { display: flex; align-items: center; gap: 20px; margin-left: auto; z-index: 101; }
  .mainNav__action-link { display: flex; align-items: center; justify-content: center; color: #000000 !important; text-decoration: none !important; transition: all 0.3s ease; position: relative; background: transparent !important; border: none !important; box-shadow: none !important; padding: 0; cursor: pointer; outline: none; }
  .mainNav__action-link:hover { color: #000; transform: scale(1.1); text-decoration: none !important; }
  .mainNav__action-link svg { width: 20px; height: 20px; stroke-width: 1.5; stroke: #000000; }
  
  .mainNav__cart { position: relative; }
  .mainNav__cart-count { position: absolute; top: -8px; right: -8px; background-color: #ffffff !important; color: #000000 !important; border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; }
  
  .mainNav__link { letter-spacing: 1px; font-size: 14px; margin-left: 20px; font-weight: 600; color: #000000 !important; text-decoration: none !important; transition: all 0.4s ease, transform 0.2s ease; padding: 2px 4px; display: flex; align-items: center; gap: 6px; position: relative; }
  .mainNav__link:hover { transform: translateY(-3px); opacity: 0.7; text-decoration: none !important; }
  
  .mainNav__dropdown-icon { width: 14px; height: 14px; stroke-width: 2; transition: transform 0.3s ease; }
  .mainNav__link-wrapper { position: relative; }
  
  .mainNav__link-wrapper:hover .mainNav__dropdown-icon,
  .mainNav__link-wrapper:focus-within .mainNav__dropdown-icon { transform: rotate(180deg); }
  
  .mainNav__megamenu { position: absolute; top: 100%; left: 0; right: auto; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 8px; box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.18); opacity: 0; visibility: hidden; transform: translateY(-10px); transition: all 0.3s ease; pointer-events: none; z-index: 1000; min-width: 300px; margin-top: 0px; padding-top: 8px; }
  
  .mainNav__link-wrapper:hover .mainNav__megamenu,
  .mainNav__link-wrapper:focus-within .mainNav__megamenu { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
  
  .mainNav__megamenu-content { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; padding: 20px; }
  .mainNav__megamenu-column { display: flex; flex-direction: column; }
  .mainNav__megamenu-title { font-weight: 700; font-size: 14px; letter-spacing: 0.5px; color: #000000; text-decoration: none !important; margin-bottom: 12px; transition: color 0.3s ease; display: inline-block; }
  .mainNav__megamenu-title:hover { color: rgba(0, 0, 0, 0.5); text-decoration: none !important; }
  .mainNav__megamenu-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .mainNav__megamenu-link { font-size: 13px; color: rgba(0, 0, 0, 0.7); text-decoration: none !important; transition: all 0.3s ease; padding: 4px 0; display: block; }
  .mainNav__megamenu-link:hover { color: #3b82f6; padding-left: 4px; text-decoration: none !important; }
  
  .mainNav__icon { 
    display: flex; 
    align-items: center; 
    justify-content: center; 
    background: transparent !important; 
    background-color: transparent !important; 
    border: none !important; 
    padding: 0; 
    margin: 0; 
    box-shadow: none !important; 
    cursor: pointer; 
    color: var(--logo-color) !important; 
    text-decoration: none !important;
    appearance: none; 
    -webkit-appearance: none; 
    -webkit-tap-highlight-color: transparent; 
    transition: all 0.3s ease; 
    outline: none; 
  }
  .mainNav__icon:hover { transform: scale(1.1); opacity: 0.7; text-decoration: none !important; }
  .mainNav__icon.active { color: #000000 !important; }
  .mainNav__icon svg { width: 20px; height: 20px; stroke-width: 1.5; stroke: currentColor; }
  
  @media screen and (min-width: 800px) { .mainNav__icon { display: none; } }
  @media screen and (max-width: 799px) { 
    .mainNav__megamenu { position: static; background-color: transparent; box-shadow: none; opacity: 0; visibility: hidden; transform: none; max-height: 0; overflow: hidden; transition: all 0.3s ease; pointer-events: none; min-width: auto; margin-top: 0; padding: 0; } 
    .mainNav__link-wrapper:hover .mainNav__megamenu,
    .mainNav__link-wrapper:focus-within .mainNav__megamenu { opacity: 0; visibility: hidden; pointer-events: none; } 
    .mainNav__link-wrapper.active .mainNav__megamenu { opacity: 1; visibility: visible; pointer-events: auto; max-height: 500px; background-color: transparent; border-radius: 0; box-shadow: none; padding: 12px 0; margin-top: 0; } 
    .mainNav__megamenu-content { grid-template-columns: 1fr; gap: 0; padding: 0 20px; } 
    .mainNav__megamenu-column { border-bottom: 1px solid rgba(0, 0, 0, 0.05); padding: 12px 0; } 
    .mainNav--active .mainNav__links { display: flex; flex-direction: column; position: absolute; top: 56px; left: 0; right: 0; background: rgba(255, 255, 255, 0.25) !important; backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border-bottom: 1px solid rgba(255, 255, 255, 0.4); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1); padding: 20px 40px; gap: 0; z-index: 101; } 
    .mainNav--active .mainNav__link-wrapper { display: block; box-shadow: none; padding: 10px 0; border-bottom: 1px solid rgba(49, 49, 49, 0.1); margin-left: 0; } 
    .mainNav--active .mainNav__link { display: flex; justify-content: space-between; align-items: center; box-shadow: none; padding: 0; margin: 0; transform: none; cursor: pointer; } 
    .mainNav--active .mainNav__dropdown-icon { width: 16px; height: 16px; } 
    .mainNav__megamenu-title { font-size: 13px; margin-bottom: 8px; } 
    .mainNav__megamenu-list { gap: 6px; } 
    .mainNav__megamenu-link { font-size: 12px; padding: 2px 0 2px 12px; } 
    .mainNav__megamenu-link:hover { padding-left: 16px; } 
  }
{% endstylesheet %}

{% javascript %}
  (function(){
    var menuToggle = document.getElementById('mobileMenuToggle');
    var mainNav = document.querySelector('.mainNav');
    var linkWrappers = document.querySelectorAll('.mainNav__link-wrapper');
    var searchToggleBtn = document.getElementById('searchToggleBtn');
    var searchDropdown = document.getElementById('searchDropdown');
    var searchInput = document.getElementById('GlassSearchInput');
    
    if(searchToggleBtn && searchDropdown) {
      searchToggleBtn.addEventListener('click', function(e) {
        e.preventDefault(); e.stopPropagation();
        var isExpanded = searchDropdown.classList.contains('is-active');
        searchDropdown.classList.toggle('is-active');
        this.setAttribute('aria-expanded', !isExpanded);
        if(!isExpanded && searchInput) {
          setTimeout(function() { searchInput.focus(); }, 100);
        }
      });
      searchDropdown.addEventListener('click', function(e) { e.stopPropagation(); });
      document.addEventListener('click', function(e) {
        if(searchDropdown.classList.contains('is-active') && !searchToggleBtn.contains(e.target)) {
          searchDropdown.classList.remove('is-active');
          searchToggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if(menuToggle && mainNav) {
      menuToggle.addEventListener('click', function(e){
        e.preventDefault(); // Empêche le saut vers le haut de la page (comportement d'un lien #)
        e.stopPropagation();
        var isExpanded = mainNav.classList.contains('mainNav--active');
        mainNav.classList.toggle('mainNav--active');
        menuToggle.classList.toggle('active');
        this.setAttribute('aria-expanded', !isExpanded);
      });
      linkWrappers.forEach(function(wrapper) {
        var megamenu = wrapper.querySelector('.mainNav__megamenu');
        var link = wrapper.querySelector('.mainNav__link');
        if(megamenu) {
          link.addEventListener('click', function(e){
            if(mainNav.classList.contains('mainNav--active')) {
              e.preventDefault();
              wrapper.classList.toggle('active');
            }
          });
        }
      });
      document.addEventListener('click', function(e){
        if(!mainNav.contains(e.target)){
          mainNav.classList.remove('mainNav--active');
          menuToggle.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
          linkWrappers.forEach(function(wrapper) { wrapper.classList.remove('active'); });
        }
      });
      var megamenuLinks = document.querySelectorAll('.mainNav__megamenu-link');
      megamenuLinks.forEach(function(link) {
        link.addEventListener('click', function(){
          if(mainNav.classList.contains('mainNav--active')) {
            mainNav.classList.remove('mainNav--active');
            menuToggle.classList.remove('active');
            menuToggle.setAttribute('aria-expanded', 'false');
            linkWrappers.forEach(function(wrapper) { wrapper.classList.remove('active'); });
          }
        });
      });
    }
  })();
{% endjavascript %}

{% schema %}
{
   "name": "Header",
   "settings": [
     { 
       "type": "link_list", 
       "id": "menu", 
       "label": "Menu", 
       "default": "main-menu" 
     },
     {
       "type": "color",
       "id": "background_color",
       "label": "Background color",
       "default": "#ffffff"
     },
     {
       "type": "color",
       "id": "text_color",
       "label": "Text color",
       "default": "#313131"
     },
     {
       "type": "range",
       "id": "padding_horizontal",
       "min": 0,
       "max": 60,
       "step": 4,
       "unit": "px",
       "label": "Horizontal padding",
       "default": 24
     }
   ],
   "presets": [
     { 
       "name": "Header" 
     }
   ]
}
{% endschema %}