{%- if product.metafields.shopify--discovery.complementary_products.value != blank -%}
  <section class="complementary-products-section">
    <div class="complementary-container">
      <h2 class="complementary-title">{{ section.settings.heading }}</h2>
      
      <div class="glass-search-grid">
        {%- for complementary_product in product.metafields.shopify--discovery.complementary_products.value limit: section.settings.product_limit -%}
          <div class="glass-search-grid-item">
            {% render 'product-card', product: complementary_product %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .complementary-products-section { 
    width: 100vw; 
    margin-left: calc(-50vw + 50%); 
    padding: 60px 20px; 
    background: transparent;
  }
  .complementary-container { 
    width: 100%; 
    max-width: 1200px; 
    margin: 0 auto; 
  }
  .complementary-title { 
    font-size: 32px; 
    font-weight: 800; 
    color: #111; 
    margin-bottom: 40px; 
    text-align: center; 
    letter-spacing: -1px;
  }
  .glass-search-grid { 
    display: grid !important; 
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)) !important; 
    gap: 32px !important; 
    align-items: stretch !important; 
  }
  .glass-search-grid-item { 
    display: block; 
    height: 100%; 
  }

  @media (max-width: 768px) { 
    .glass-search-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 20px !important; } 
    .complementary-title { font-size: 26px; }
    .complementary-products-section { padding: 40px 20px; }
  }
  @media (max-width: 550px) { 
    .glass-search-grid { grid-template-columns: 1fr !important; gap: 20px !important; } 
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complementary products",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Complementary products"
    }
  ]
}
{% endschema %}