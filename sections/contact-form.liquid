{%- style -%}
  #shopify-section-{{ section.id }} .snowpeak-contact-page {
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
    {% else %}
      background-color: {{ section.settings.bg_color | default: '#e2e8f0' }};
    {% endif %}
  }
{%- endstyle -%}

<section class="snowpeak-contact-page">
  <div class="page-width">
    <div class="glass-contact-panel">
      <h1 class="contact-title">{{ page.title | default: section.settings.heading | default: 'Contact Us' }}</h1>

      {%- if page.content != blank -%}
        <div class="contact-page-content rte">
          {{ page.content }}
        </div>
      {%- endif -%}

      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div class="form-status-success">
            ✓ Thanks for contacting us. We'll get back to you as soon as possible.
          </div>
        {%- endif -%}

        <div class="contact-fields-grid">
          <div class="field-group">
            <label for="ContactForm-name">Name</label>
            <input class="glass-input" type="text" id="ContactForm-name" name="contact[Name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your name" required>
          </div>

          <div class="field-group">
            <label for="ContactForm-email">Email</label>
            <input autocomplete="email" type="email" id="ContactForm-email" class="glass-input {% if form.errors contains 'email' %}error{% endif %}" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" placeholder="Your email" required>
            {%- if form.errors contains 'email' -%}
              <small class="field-error">
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </small>
            {%- endif -%}
          </div>
        </div>

        <div class="field-group">
          <label for="ContactForm-body">Message</label>
          <textarea rows="6" id="ContactForm-body" class="glass-textarea" name="contact[Message]" placeholder="How can we help you?" required>{{- form.body -}}</textarea>
        </div>

        <div class="contact-submit">
          <button type="submit" class="btn-primary-send">
            Send Message
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .snowpeak-contact-page {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 140px 20px 60px 20px !important;
    min-height: 100vh;
    background-attachment: fixed;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
  }

  .snowpeak-contact-page .page-width {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .glass-contact-panel {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    border-radius: 1.5rem;
    padding: 50px 60px;
  }

  .contact-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: #111;
    margin-bottom: 20px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: -1px;
  }

  /* Styles pour le texte ajouté depuis l'éditeur Shopify */
  .contact-page-content.rte {
    text-align: center;
    margin-bottom: 40px;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
  }

  .contact-page-content.rte p {
    margin-bottom: 10px;
  }

  .contact-page-content.rte a {
    color: #111;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .contact-fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
  }

  .field-group label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .glass-input, .glass-textarea {
    width: 100%;
    padding: 16px;
    background: rgba(255, 255, 255, 0.6) !important;
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    color: #111 !important;
    border-radius: 12px;
    font-size: 1rem;
    outline: none;
    transition: all 0.3s ease;
  }

  .glass-textarea {
    resize: vertical;
    min-height: 150px;
  }

  .glass-input:focus, .glass-textarea:focus {
    background: rgba(255, 255, 255, 0.9) !important;
    border-color: rgba(0, 0, 0, 0.3) !important;
    box-shadow: 0 0 0 4px rgba(0,0,0,0.05);
  }

  .glass-input::placeholder, .glass-textarea::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  .glass-input.error {
    border-color: #e74c3c !important;
    background: rgba(231, 76, 60, 0.1) !important;
  }

  .field-error {
    color: #e74c3c;
    font-size: 0.85rem;
    margin-top: 5px;
    font-weight: 600;
  }

  .form-status-success {
    background: #2ecc71;
    color: white;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 30px;
    font-weight: 600;
    text-align: center;
  }

  .contact-submit {
    margin-top: 10px;
  }

  .btn-primary-send {
    display: block;
    width: 100%;
    padding: 16px;
    background-color: #000;
    color: #fff;
    border: none;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .btn-primary-send:hover {
    background-color: #333;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }

  @media (max-width: 768px) {
    .contact-fields-grid { grid-template-columns: 1fr; gap: 0; }
    .snowpeak-contact-page { padding: 120px 15px 40px 15px !important; }
    .glass-contact-panel { padding: 30px 20px; }
    .contact-title { font-size: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background Color",
      "default": "#e2e8f0"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}