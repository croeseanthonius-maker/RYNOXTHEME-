{%- style -%}
  #shopify-section-{{ section.id }} .snowpeak-article-page,
  .snowpeak-article-page {
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
    {% else %}
      background-color: {{ section.settings.bg_color | default: '#e2e8f0' }};
    {% endif %}
  }
{%- endstyle -%}

<article class="snowpeak-article-page">
  <div class="page-width">
    
    <div class="article-glass-container">
      <div class="article-header">
        <a href="{{ blog.url }}" class="back-to-blog">&larr; Back to {{ blog.title }}</a>
        <h1 class="article-title">{{ article.title }}</h1>
        <div class="article-meta">
          <span class="article-date">{{ article.published_at | time_tag: format: 'date' }}</span>
          {%- if section.settings.show_author != false -%}
            <span class="article-author">| By {{ article.author }}</span>
          {%- endif -%}
        </div>
      </div>

      {%- if article.image -%}
        <div class="article-image-wrapper">
          <img
            src="{{ article.image | image_url: width: 1200 }}"
            alt="{{ article.image.alt | escape }}"
            class="article-image"
            loading="lazy"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
          >
        </div>
      {%- endif -%}

      <div class="article-content rte">
        {{ article.content }}
      </div>
      
      {%- if blog.comments_enabled? -%}
        <div class="article-comments" id="comments" style="margin-top: 50px; padding-top: 40px; border-top: 1px solid rgba(0,0,0,0.1);">
          {%- if article.comments_count > 0 -%}
            <h2 style="font-family: var(--font-heading-family); margin-bottom: 20px;">Comments ({{ article.comments_count }})</h2>
            {%- paginate article.comments by 5 -%}
              {%- for comment in article.comments -%}
                <div class="comment-item" style="background: rgba(255,255,255,0.4); padding: 20px; border-radius: 12px; margin-bottom: 15px;">
                  <strong>{{ comment.author }}</strong>
                  <span style="font-size: 0.85rem; color: #555; margin-left: 10px;">{{ comment.created_at | time_tag: format: 'date' }}</span>
                  <div style="margin-top: 10px;">{{ comment.content }}</div>
                </div>
              {%- endfor -%}
              {{ paginate | default_pagination }}
            {%- endpaginate -%}
          {%- endif -%}

          {% form 'new_comment', article %}
            <h2 style="font-family: var(--font-heading-family); margin: 40px 0 20px;">Leave a comment</h2>
            {%- if form.posted_successfully? -%}
              <p style="color: #27ae60; font-weight: 600;">Comment posted successfully!</p>
            {%- elsif form.errors -%}
              <p style="color: #e74c3c; font-weight: 600;">Please fix the errors below to submit your comment.</p>
            {%- endif -%}
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
              <div>
                <label for="CommentAuthor" style="display:block; margin-bottom:8px; font-weight:600;">Name</label>
                <input type="text" name="comment[author]" id="CommentAuthor" value="{{ form.author }}" required style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); background: rgba(255,255,255,0.6); outline: none;">
              </div>
              <div>
                <label for="CommentEmail" style="display:block; margin-bottom:8px; font-weight:600;">Email</label>
                <input type="email" name="comment[email]" id="CommentEmail" value="{{ form.email }}" required style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); background: rgba(255,255,255,0.6); outline: none;">
              </div>
            </div>
            <div style="margin-bottom: 20px;">
              <label for="CommentBody" style="display:block; margin-bottom:8px; font-weight:600;">Message</label>
              <textarea name="comment[body]" id="CommentBody" required style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid rgba(0,0,0,0.1); background: rgba(255,255,255,0.6); outline: none; min-height: 120px;">{{ form.body }}</textarea>
            </div>
            <button type="submit" class="btn-glass-back" style="background: #111; color: #fff;">Post comment</button>
          {% endform %}
        </div>
      {%- endif -%}

      <div class="article-footer">
        <a href="{{ blog.url }}" class="btn-glass-back">Explore more articles</a>
      </div>
    </div>

  </div>
</article>

{% stylesheet %}
   .snowpeak-article-page { width: 100vw; margin-left: calc(-50vw + 50%); padding: 140px 20px 80px 20px; min-height: 100vh; background-attachment: fixed; background-repeat: no-repeat; background-size: cover; background-position: center; }
   .snowpeak-article-page .page-width { max-width: 900px; margin: 0 auto; }
   .article-glass-container { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.6); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1); border-radius: 24px; padding: 60px; overflow: hidden; }
   .back-to-blog { display: inline-block; font-size: 0.9rem; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: 1px; text-decoration: none !important; margin-bottom: 20px; transition: color 0.3s ease; }
   .back-to-blog:hover { color: #111; }
   .article-title { font-size: 3.5rem; font-weight: 800; color: #111; margin: 0 0 15px 0; line-height: 1.1; letter-spacing: -1px; font-family: var(--font-heading-family); }
   .article-meta { font-size: 1rem; color: #555; margin-bottom: 40px; font-weight: 600; }
   .article-image-wrapper { width: 100%; border-radius: 16px; overflow: hidden; margin-bottom: 40px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
   .article-image { width: 100%; height: auto; display: block; }
   .article-content { font-size: 1.15rem; line-height: 1.8; color: #222; }
   .article-content p { margin-bottom: 25px; }
   .article-content h2, .article-content h3 { color: #111; font-weight: 700; margin: 40px 0 20px 0; }
   .article-content a { color: #111; font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
   .article-footer { margin-top: 60px; padding-top: 40px; border-top: 1px solid rgba(0, 0, 0, 0.1); text-align: center; }
   .btn-glass-back { display: inline-block; padding: 15px 40px; background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(0, 0, 0, 0.1); color: #111; text-decoration: none !important; border-radius: 50px; font-weight: 700; letter-spacing: 1px; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); }
   .btn-glass-back:hover { background: #111; color: #fff; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15); }
   @media (max-width: 768px) { .snowpeak-article-page { padding: 120px 15px 40px 15px; } .article-glass-container { padding: 30px 20px; border-radius: 16px; } .article-title { font-size: 2.2rem; } .article-content { font-size: 1.05rem; } }
{% endstylesheet %}

{% schema %}
{
   "name": "Article content",
   "settings": [
     {
       "type": "image_picker",
       "id": "bg_image",
       "label": "Background image"
     },
     {
       "type": "color",
       "id": "bg_color",
       "label": "Fallback background color",
       "default": "#e2e8f0"
     },
     {
       "type": "checkbox",
       "id": "show_author",
       "label": "Show article author",
       "default": true
     }
   ],
   "presets": [
     {
       "name": "Article content"
     }
   ]
}
{% endschema %}