<section class="embla" id="embla-{{ section.id }}">
  {% if section.settings.show_title %}
    <div class="embla__title">
      <h2>{{ section.settings.carousel_title }}</h2>
      {% if section.settings.carousel_subtitle != blank %}
        <p>{{ section.settings.carousel_subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="embla__viewport">
    <div class="embla__container">
      
      {%- liquid
        assign max_products = section.settings.max_products
        assign rendered_count = 0
        assign only_on_sale = section.settings.only_on_sale
      -%}

      {%- if section.settings.collection_list != blank -%}
        {%- for collection in section.settings.collection_list -%}
          {%- for product in collection.products -%}
            {%- if rendered_count >= max_products -%}{%- break -%}{%- endif -%}

            {%- assign is_on_sale = false -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign is_on_sale = true -%}
            {%- endif -%}

            {%- if only_on_sale and is_on_sale == false -%}
              {%- continue -%}
            {%- endif -%}

            <div class="embla__slide">
              {% render 'product-card', product: product %}
            </div>
            {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- endfor -%}
          {%- if rendered_count >= max_products -%}{%- break -%}{%- endif -%}
        {%- endfor -%}

      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.product != blank -%}
            {%- assign product = block.settings.product -%}
            
            {%- assign is_on_sale = false -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign is_on_sale = true -%}
            {%- endif -%}

            {%- if only_on_sale and is_on_sale == false -%}
              {%- continue -%}
            {%- endif -%}

            <div class="embla__slide">
              {% render 'product-card', product: product %}
            </div>
            {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if rendered_count == 0 -%}
        <div class="embla__slide">
          <div style="text-align: center; padding: 50px; background: rgba(255,255,255,0.4); backdrop-filter: blur(10px); border-radius: 1.5rem; border: 1px solid rgba(255,255,255,0.6);">
            <p style="color: #111; font-weight: 600; margin: 0;">No products to display.</p>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>

  <div class="embla__controls">
    <button class="embla__button embla__button--prev" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="embla__button embla__button--next" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  {% if section.settings.button_label != blank %}
    <div class="embla__view-all">
      <button type="button" class="btn embla__view-all-btn">
        {{ section.settings.button_label }}
      </button>
    </div>
  {% endif %}

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const section = document.getElementById('embla-{{ section.id }}');
      if (!section) return;

      const viewport = section.querySelector('.embla__viewport');
      const prevBtn = section.querySelector('.embla__button--prev');
      const nextBtn = section.querySelector('.embla__button--next');
      const viewAllBtn = section.querySelector('.embla__view-all-btn');

      function updateButtons() {
        if (!prevBtn || !nextBtn) return;
        prevBtn.disabled = viewport.scrollLeft <= 0;
        nextBtn.disabled = Math.ceil(viewport.scrollLeft + viewport.clientWidth) >= viewport.scrollWidth;
      }

      function getNextTarget() {
        const viewportRect = viewport.getBoundingClientRect();
        const slides = viewport.querySelectorAll('.embla__slide');
        for (let slide of slides) {
          const rect = slide.getBoundingClientRect();
          if (rect.left > viewportRect.left + 10) {
            return viewport.scrollLeft + (rect.left - viewportRect.left);
          }
        }
        return viewport.scrollLeft + viewport.clientWidth;
      }

      function getPrevTarget() {
        const viewportRect = viewport.getBoundingClientRect();
        const slides = Array.from(viewport.querySelectorAll('.embla__slide')).reverse();
        for (let slide of slides) {
          const rect = slide.getBoundingClientRect();
          if (rect.left < viewportRect.left - 10) {
            return viewport.scrollLeft + (rect.left - viewportRect.left);
          }
        }
        return viewport.scrollLeft - viewport.clientWidth;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          viewport.scrollTo({ left: getPrevTarget(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          viewport.scrollTo({ left: getNextTarget(), behavior: 'smooth' });
        });
      }

      if (viewAllBtn) {
        viewAllBtn.addEventListener('click', function() {
          section.classList.toggle('is-expanded');
          
          if (section.classList.contains('is-expanded')) {
            viewAllBtn.textContent = "{{ section.settings.button_label_less | default: 'Show less' }}";
          } else {
            viewAllBtn.textContent = "{{ section.settings.button_label }}";
            viewport.scrollTo({ left: 0, behavior: 'smooth' });
          }
        });
      }

      viewport.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);
      
      updateButtons();
    });
  </script>
</section>

{% stylesheet %}
  .embla {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 40px 0;
    --slide-size: 85%;
    transition: all 0.3s ease;
  }

  .embla__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px;
  }

  .embla__viewport::-webkit-scrollbar {
    display: none;
  }

  .embla__container {
    display: flex;
    gap: 20px;
    padding-bottom: 20px;
  }

  .embla__slide {
    flex: 0 0 var(--slide-size);
    min-width: 0;
    scroll-snap-align: center;
  }

  .embla.is-expanded .embla__viewport {
    overflow: visible;
    scroll-snap-type: none;
  }

  .embla.is-expanded .embla__container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    padding-bottom: 0;
  }

  .embla.is-expanded .embla__slide {
    flex: unset;
    width: 100%;
    scroll-snap-align: none;
  }

  .embla.is-expanded .embla__controls {
    display: none;
  }

  .embla__title {
    text-align: center;
    margin-bottom: 40px;
    padding: 0 20px;
  }

  .embla__title h2 {
    margin: 0 0 10px 0;
    font-size: 32px;
    font-weight: 700;
    color: var(--color-heading-text, #18181B);
    letter-spacing: -1px;
  }

  .embla__title p {
    margin: 0;
    font-size: 16px;
    color: var(--color-body-text, #52525B);
    line-height: 1.6;
  }

  .embla__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    margin-top: 10px;
  }

  .embla__button {
    -webkit-tap-highlight-color: transparent;
    -webkit-appearance: none;
    appearance: none;
    background-color: transparent;
    touch-action: manipulation;
    cursor: pointer;
    border: 2px solid var(--color-button-bg, #333);
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    color: var(--color-button-bg, #333);
    transition: all 0.3s ease;
  }

  .embla__button:hover:not(:disabled) {
    background-color: var(--color-button-bg, #333);
    color: var(--color-button-text, #fff);
  }

  .embla__button:disabled {
    opacity: 0.2;
    cursor: not-allowed;
    border-color: #999;
    color: #999;
  }

  .embla__view-all {
    display: flex;
    justify-content: center;
    margin-top: 30px;
    padding: 0 20px;
  }

  .embla__view-all .btn {
    padding: 12px 30px;
    font-size: 14px;
    border-radius: 50px;
  }

  @media (max-width: 768px) {
    .embla { padding: 30px 0; }
    .embla__title h2 { font-size: 24px; }
    .embla__title p { font-size: 14px; }
    .embla__controls { gap: 20px; }
    .embla__button { width: 40px; height: 40px; }
  }

  @media (min-width: 768px) {
    .embla { --slide-size: calc(50% - 10px); }
    .embla__slide { scroll-snap-align: start; }
    .embla.is-expanded .embla__container { grid-template-columns: repeat(3, 1fr); gap: 20px; }
  }

  @media (min-width: 1024px) {
    .embla { --slide-size: calc(33.333% - 13.33px); }
    .embla.is-expanded .embla__container { grid-template-columns: repeat(4, 1fr); }
  }

  @media (min-width: 1280px) {
    .embla { --slide-size: calc(25% - 15px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Titles"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "text",
      "id": "carousel_title",
      "label": "Carousel title",
      "default": "Special Promotion"
    },
    {
      "type": "text",
      "id": "carousel_subtitle",
      "label": "Carousel subtitle",
      "default": "Discover our amazing deals on selected items"
    },
    {
      "type": "header",
      "content": "Data source"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections to display"
    },
    {
      "type": "checkbox",
      "id": "only_on_sale",
      "label": "Only show products on sale",
      "default": false
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Maximum products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "View All Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (Expand)",
      "default": "View all products"
    },
    {
      "type": "text",
      "id": "button_label_less",
      "label": "Button label (Collapse)",
      "default": "Show less"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Manual product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}