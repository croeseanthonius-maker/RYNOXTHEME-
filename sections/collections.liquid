<div class="collections-page">
  <div class="bento-container">
    <h1 class="page-title">{{ 'collections.title' | t | default: 'Our Collections' }}</h1>
    
    {% paginate collections by 12 %}
      <div class="bento-grid">
        {% for collection in collections %}
          {% assign collection_image = collection.featured_image %}
          
          <a href="{{ collection.url }}" class="bento-item" {% if collection_image %}style="background-image: url('{{ collection_image | image_url: width: 800 }}');"{% else %}style="background-color: #1a1a1a;"{% endif %}>
            <div class="bento-glass-panel">
              <h3 class="bento-title">{{ collection.title }}</h3>
              {% if collection.description != blank %}
                <p class="bento-description">{{ collection.description | strip_html | truncatewords: 15 }}</p>
              {% endif %}
              <span class="bento-btn">Explore</span>
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="glass-pagination-wrapper">
          {{ paginate | default_pagination: next: '→', previous: '←' }}
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</div>

<style>
  .collections-page {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 60px 0;
    min-height: 100vh;
    background-attachment: fixed;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  .bento-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .page-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 50px;
    color: #111;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    grid-auto-rows: 400px;
    gap: 25px;
  }

  .bento-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    cursor: pointer;
    text-decoration: none !important;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    display: block;
  }

  .bento-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  .bento-glass-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: linear-gradient(135deg, rgba(30, 30, 30, 0.6) 0%, rgba(30, 30, 30, 0.4) 100%);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding: 25px 20px;
    color: white;
    text-align: center;
    height: auto;
    transition: all 0.3s ease;
  }

  .bento-item:hover .bento-glass-panel {
    background: linear-gradient(135deg, rgba(30, 30, 30, 0.8) 0%, rgba(30, 30, 30, 0.6) 100%);
    padding-bottom: 30px;
  }

  .bento-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 10px 0;
    letter-spacing: 0.5px;
    color: #ffffff;
    font-family: var(--font-heading-family);
    text-transform: uppercase;
  }

  .bento-description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 15px 0;
    line-height: 1.5;
  }

  .bento-btn {
    display: inline-block;
    padding: 10px 30px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .bento-item:hover .bento-btn {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .glass-pagination-wrapper {
    margin-top: 60px;
    text-align: center;
  }

  .glass-pagination-wrapper .pagination {
    display: inline-flex;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
    align-items: center;
  }

  .glass-pagination-wrapper span.page a,
  .glass-pagination-wrapper span.prev a,
  .glass-pagination-wrapper span.next a,
  .glass-pagination-wrapper span.deco {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 45px;
    height: 45px;
    padding: 0 15px;
    background: rgba(30, 30, 30, 0.4);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    color: #111;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .glass-pagination-wrapper span.page a:hover,
  .glass-pagination-wrapper span.prev a:hover,
  .glass-pagination-wrapper span.next a:hover {
    background: rgba(30, 30, 30, 0.8);
    color: #fff;
    transform: translateY(-2px);
  }

  .glass-pagination-wrapper span.current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 45px;
    height: 45px;
    background: #111;
    color: #fff;
    border-radius: 50px;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  @media screen and (max-width: 768px) {
    .collections-page {
      padding: 40px 0;
    }

    .bento-container {
      padding: 0 20px;
    }

    .page-title {
      font-size: 2rem;
      margin-bottom: 30px;
    }

    .bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 350px;
      gap: 15px;
    }

    .bento-glass-panel {
      padding: 20px 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Collections Grid",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cette page affiche automatiquement toutes les collections de votre boutique en utilisant le design Glassmorphism."
    }
  ]
}
{% endschema %}
