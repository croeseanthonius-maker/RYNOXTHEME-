{%- style -%}
  #shopify-section-{{ section.id }} .snowpeak-blog-page {
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
    {% else %}
      background-color: {{ section.settings.bg_color | default: '#e2e8f0' }};
    {% endif %}
  }
{%- endstyle -%}

<section class="snowpeak-blog-page">
  <div class="page-width">
    
    <div class="blog-header-glass">
      <h1 class="blog-main-title">{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 9 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <div class="blog-card-glass">
            <a href="{{ article.url }}" class="blog-card-link">
              <div class="blog-card-image-wrapper">
                {%- if article.image -%}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    alt="{{ article.image.alt | escape }}"
                    class="blog-card-image"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                {%- else -%}
                  <div class="blog-card-placeholder"></div>
                {%- endif -%}
              </div>
              
              <div class="blog-card-content">
                <div class="blog-card-meta">
                  <span class="blog-card-date">{{ article.published_at | time_tag: format: 'date' }}</span>
                  {%- if section.settings.show_author -%}
                    <span class="blog-card-author">| {{ article.author }}</span>
                  {%- endif -%}
                </div>
                
                <h3 class="blog-card-title">{{ article.title }}</h3>
                
                <p class="blog-card-excerpt">
                  {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
                </p>
                
                <span class="blog-card-readmore">Read article &rarr;</span>
              </div>
            </a>
          </div>
        {%- else -%}
          <div class="blog-empty-glass">
            <p>No articles found in this blog.</p>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="blog-pagination-glass">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>

{% stylesheet %}
  .snowpeak-blog-page {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 140px 20px 80px 20px;
    min-height: 100vh;
    background-attachment: fixed;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  .snowpeak-blog-page .page-width {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-header-glass {
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border-radius: 20px;
    padding: 40px;
    text-align: center;
    margin-bottom: 50px;
  }

  .blog-main-title {
    font-size: 3rem;
    font-weight: 800;
    color: #111;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    font-family: var(--font-heading-family);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
  }

  .blog-card-glass {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
  }

  .blog-card-glass:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    background: rgba(255, 255, 255, 0.8);
  }

  .blog-card-link {
    text-decoration: none !important;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blog-card-image-wrapper {
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .blog-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card-glass:hover .blog-card-image {
    transform: scale(1.05);
  }

  .blog-card-placeholder {
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.1);
  }

  .blog-card-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .blog-card-meta {
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .blog-card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 15px;
    line-height: 1.3;
  }

  .blog-card-excerpt {
    font-size: 1rem;
    color: #444;
    line-height: 1.6;
    margin-bottom: 25px;
    flex-grow: 1;
  }

  .blog-card-readmore {
    font-weight: 700;
    color: #111;
    font-size: 0.95rem;
    display: inline-block;
    border-bottom: 2px solid #111;
    padding-bottom: 2px;
    align-self: flex-start;
    transition: all 0.2s ease;
  }

  .blog-card-glass:hover .blog-card-readmore {
    color: #555;
    border-color: #555;
  }

  .blog-empty-glass {
    grid-column: 1 / -1;
    background: rgba(255, 255, 255, 0.5);
    padding: 40px;
    border-radius: 16px;
    text-align: center;
    font-weight: 600;
  }

  .blog-pagination-glass {
    margin-top: 50px;
    text-align: center;
    padding: 20px;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50px;
    display: inline-block;
  }
  
  .blog-pagination-glass a, .blog-pagination-glass span {
    padding: 10px 15px;
    margin: 0 5px;
    color: #111;
    text-decoration: none;
    font-weight: 600;
  }

  .blog-pagination-glass .current {
    background: #111;
    color: #fff;
    border-radius: 50px;
  }

  @media (max-width: 768px) {
    .snowpeak-blog-page { padding: 120px 15px 60px 15px; }
    .blog-main-title { font-size: 2.2rem; }
    .blog-header-glass { padding: 30px 20px; margin-bottom: 30px; }
    .blog-grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback Background Color",
      "default": "#e2e8f0"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show article author",
      "default": true
    }
  ]
}
{% endschema %}