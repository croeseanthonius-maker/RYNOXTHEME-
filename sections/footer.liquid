<footer class="footer-modern" style="background: linear-gradient(135deg, {{ section.settings.bg_color_1 | default: '#0a0a0a' }} 0%, {{ section.settings.bg_color_2 | default: '#1a1a1a' }} 100%);">
  
  <div class="footer-top-section">
    <div class="container">
      <div class="footer-top-grid">
        <div class="footer-logo-wrapper">
          <a href="{{ routes.root_url }}">
            {% if settings.logo != blank %}
              {{ settings.logo | image_url: width: 200 | image_tag: alt: shop.name, class: 'footer-logo' }}
            {% else %}
              <span class="footer-shop-name">{{ shop.name }}</span>
            {% endif %}
          </a>
        </div>

        <div class="social-media-wrapper">
          <ul class="social-links">
            {% if section.settings.facebook_url %}
            <li><a href="{{ section.settings.facebook_url }}" class="btn-social" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg></a></li>
            {% endif %}
            {% if section.settings.twitter_url %}
            <li><a href="{{ section.settings.twitter_url }}" class="btn-social" aria-label="X (formerly Twitter)"><svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"/></svg></a></li>
            {% endif %}
            {% if section.settings.instagram_url %}
            <li><a href="{{ section.settings.instagram_url }}" class="btn-social" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a></li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <section class="footer-links-section">
    <div class="container">
      <div class="footer-links-grid">
        <div class="footer-link-column">
          <h4 class="footer-heading">{{ section.settings.col1_title }}</h4>
          {% if section.settings.col1_menu %}
          <ul class="footer-menu">
            {% for link in linklists[section.settings.col1_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        
        <div class="footer-link-column">
          <h4 class="footer-heading">{{ section.settings.col2_title }}</h4>
          {% if section.settings.col2_menu %}
          <ul class="footer-menu">
            {% for link in linklists[section.settings.col2_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        
        <div class="footer-link-column">
          <h4 class="footer-heading">{{ section.settings.col3_title }}</h4>
          {% if section.settings.col3_menu %}
          <ul class="footer-menu">
            {% for link in linklists[section.settings.col3_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        
        <div class="footer-link-column">
          <h4 class="footer-heading">{{ section.settings.col4_title }}</h4>
          {% if section.settings.col4_menu %}
          <ul class="footer-menu">
            {% for link in linklists[section.settings.col4_menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <div class="footer-localization-section">
    <div class="container">
      <div class="localization-wrapper">
        
        {%- if localization.available_countries.size > 1 -%}
          <div class="localization-form-wrapper">
            {%- form 'localization', id: 'FooterCountryForm' -%}
              <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
              <div class="dropdown-glass">
                <button type="button" class="btn-glass-select" aria-expanded="false" aria-controls="FooterCountryList">
                  {{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <ul id="FooterCountryList" class="dropdown-glass-list custom-scrollbar" hidden>
                  {%- for country in localization.available_countries -%}
                    <li>
                      <a href="#" {% if country.iso_code == localization.country.iso_code %}aria-current="true"{% endif %} data-value="{{ country.iso_code }}">
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- if localization.available_languages.size > 1 -%}
          <div class="localization-form-wrapper">
            {%- form 'localization', id: 'FooterLanguageForm' -%}
              <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
              <div class="dropdown-glass">
                <button type="button" class="btn-glass-select" aria-expanded="false" aria-controls="FooterLanguageList">
                  {{ localization.language.endonym_name | capitalize }}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <ul id="FooterLanguageList" class="dropdown-glass-list custom-scrollbar" hidden>
                  {%- for language in localization.available_languages -%}
                    <li>
                      <a href="#" {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %} data-value="{{ language.iso_code }}">
                        {{ language.endonym_name | capitalize }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endform -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>

  <div class="footer-bottom-section">
    <div class="container">
      <div class="footer-bottom-grid">
        
        <div class="footer-bottom-left">
          <div class="copyright-wrapper">
            &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}
          </div>
          <div class="credit-wrapper">
            {{ section.settings.credit_text }}
          </div>
        </div>
        
        <div class="footer-bottom-center">
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer-follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
        </div>

        <div class="footer-bottom-right">
          <ul class="footer-legal-links">
            {% if section.settings.show_shipping %}
            <li><a href="{{ section.settings.shipping_url }}">{{ section.settings.shipping_text }}</a></li>
            {% endif %}
            {% if section.settings.show_refund %}
            <li><a href="{{ section.settings.refund_url }}">{{ section.settings.refund_text }}</a></li>
            {% endif %}
            {% if section.settings.show_privacy %}
            <li><a href="{{ section.settings.privacy_url }}">{{ section.settings.privacy_text }}</a></li>
            {% endif %}
          </ul>
        </div>

      </div>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const dropdownBtns = document.querySelectorAll('.btn-glass-select');
    
    dropdownBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !expanded);
        const list = this.nextElementSibling;
        if (expanded) {
          list.setAttribute('hidden', '');
        } else {
          list.removeAttribute('hidden');
        }
      });
    });

    const listLinks = document.querySelectorAll('.dropdown-glass-list a');
    listLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const form = this.closest('form');
        
        let hiddenInput = form.querySelector('input[name="country_code"]');
        if (!hiddenInput) {
          hiddenInput = form.querySelector('input[name="locale_code"]');
        }
        
        if (hiddenInput) {
          hiddenInput.value = this.dataset.value;
          form.submit();
        }
      });
    });

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.dropdown-glass')) {
        document.querySelectorAll('.dropdown-glass-list').forEach(list => {
          list.setAttribute('hidden', '');
        });
        document.querySelectorAll('.btn-glass-select').forEach(btn => {
          btn.setAttribute('aria-expanded', 'false');
        });
      }
    });
  });
</script>

{% stylesheet %}
  .footer-modern { 
    border-top: 1px solid rgba(255, 255, 255, 0.1); 
    position: relative; 
    overflow: hidden; 
    width: 100vw; 
    margin-left: calc(-50vw + 50%); 
  }
  
  .footer-modern .container { 
    width: 100%; 
    max-width: var(--page-width, 1200px); 
    padding: 0 40px; 
    margin: 0 auto; 
    box-sizing: border-box; 
  }
  
  /* --- TOP SECTION --- */
  .footer-top-section { 
    background: rgba(0, 0, 0, 0.3); 
    backdrop-filter: blur(15px); 
    -webkit-backdrop-filter: blur(15px); 
    padding: 30px 0; 
    border-bottom: 1px solid rgba(255, 255, 255, 0.05); 
  }
  
  .footer-top-grid { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    flex-wrap: wrap; 
    gap: 20px; 
  }
  
  .footer-logo-wrapper a { text-decoration: none; }
  .footer-logo { max-height: 50px; width: auto; filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3)); }
  .footer-shop-name { color: white; font-size: 24px; font-weight: 700; letter-spacing: 2px; text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5); }
  
  .social-links { 
    display: flex; 
    gap: 12px; 
    list-style: none; 
    padding: 0; 
    margin: 0; 
  }
  
  .btn-social { 
    border: 1px solid rgba(255, 255, 255, 0.25); 
    color: white; 
    width: 44px; 
    height: 44px; 
    display: inline-flex; 
    align-items: center; 
    justify-content: center; 
    border-radius: 50%; 
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.05) 100%); 
    backdrop-filter: blur(15px); 
    -webkit-backdrop-filter: blur(15px); 
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2), inset 0 1px 1px rgba(255, 255, 255, 0.2); 
  }
  
  .btn-social:hover { 
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.1) 100%); 
    transform: translateY(-4px); 
    border-color: rgba(255, 255, 255, 0.4); 
    box-shadow: 0 12px 24px rgba(147, 112, 219, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.3); 
    color: white;
  }

  /* --- LINKS SECTION --- */
  .footer-links-section { 
    background: rgba(0, 0, 0, 0.2); 
    backdrop-filter: blur(10px); 
    -webkit-backdrop-filter: blur(10px); 
    padding: 60px 0; 
  }
  
  .footer-links-grid { 
    display: grid; 
    grid-template-columns: repeat(4, 1fr); 
    gap: 30px; 
  }
  
  .footer-heading { 
    color: #fff; 
    font-size: 16px; 
    font-weight: 600; 
    margin: 0 0 20px 0; 
    text-transform: uppercase; 
    letter-spacing: 0.5px; 
    position: relative;
    display: inline-block;
  }
  
  .footer-heading::after { 
    content: ''; 
    position: absolute; 
    bottom: -8px; 
    left: 0; 
    width: 30px; 
    height: 2px; 
    background: linear-gradient(90deg, rgba(147, 112, 219, 0.9) 0%, transparent 100%); 
  }
  
  .footer-menu { 
    list-style: none; 
    padding: 0; 
    margin: 0; 
  }
  
  .footer-menu li { margin-bottom: 12px; }
  
  .footer-menu a { 
    color: rgba(255, 255, 255, 0.7); 
    text-decoration: none; 
    transition: all 0.3s ease; 
    font-size: 14px; 
  }
  
  .footer-menu a:hover { 
    color: #fff; 
    padding-left: 4px; 
  }

  /* --- LOCALIZATION SECTION --- */
  .footer-localization-section { 
    background: rgba(0, 0, 0, 0.2); 
    padding-bottom: 40px; 
  }
  
  .localization-wrapper { 
    display: flex; 
    gap: 15px; 
    flex-wrap: wrap; 
  }
  
  .dropdown-glass { position: relative; display: inline-block; }
  .btn-glass-select { 
    background: rgba(255, 255, 255, 0.1); 
    border: 1px solid rgba(255, 255, 255, 0.2); 
    color: #fff; 
    padding: 10px 20px; 
    border-radius: 50px; 
    font-size: 13px; 
    font-weight: 600; 
    display: flex; 
    align-items: center; 
    gap: 8px; 
    cursor: pointer; 
    transition: all 0.3s ease; 
    backdrop-filter: blur(10px); 
  }
  .btn-glass-select:hover { background: rgba(255, 255, 255, 0.2); }
  
  .dropdown-glass-list { 
    position: absolute; 
    bottom: calc(100% + 10px); 
    left: 0; 
    background: rgba(20, 20, 20, 0.9); 
    backdrop-filter: blur(20px); 
    -webkit-backdrop-filter: blur(20px); 
    border: 1px solid rgba(255, 255, 255, 0.2); 
    border-radius: 12px; 
    padding: 10px 0; 
    margin: 0; 
    list-style: none; 
    min-width: 200px; 
    z-index: 100; 
    box-shadow: 0 10px 30px rgba(0,0,0,0.5); 
    max-height: 250px; 
    overflow-y: auto; 
  }
  .dropdown-glass-list[hidden] { display: none; }
  .dropdown-glass-list li a { 
    display: block; 
    padding: 8px 20px; 
    color: rgba(255, 255, 255, 0.8); 
    text-decoration: none; 
    font-size: 13px; 
    transition: all 0.2s ease; 
  }
  .dropdown-glass-list li a:hover, .dropdown-glass-list li a[aria-current="true"] { 
    background: rgba(255, 255, 255, 0.1); 
    color: #fff; 
  }
  
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 10px; margin: 5px 0; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.25); border-radius: 10px; }

  /* --- BOTTOM SECTION --- */
  .footer-bottom-section { 
    background: rgba(0, 0, 0, 0.4); 
    backdrop-filter: blur(15px); 
    -webkit-backdrop-filter: blur(15px); 
    border-top: 1px solid rgba(255, 255, 255, 0.05); 
    padding: 30px 0; 
  }
  
  .footer-bottom-grid { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    flex-wrap: wrap; 
    gap: 20px; 
  }
  
  .footer-bottom-left { flex: 1; min-width: 250px; }
  .copyright-wrapper { font-size: 14px; color: rgba(255, 255, 255, 0.85); margin-bottom: 5px; }
  .credit-wrapper { font-size: 12px; color: rgba(255, 255, 255, 0.6); }
  
  .footer-bottom-center { flex: 1; display: flex; justify-content: center; min-width: 250px; }
  
  .footer-bottom-right { flex: 1; display: flex; justify-content: flex-end; min-width: 250px; }
  .footer-legal-links { 
    display: flex; 
    gap: 15px; 
    list-style: none; 
    padding: 0; 
    margin: 0; 
  }
  
  .footer-legal-links a { 
    color: rgba(255, 255, 255, 0.7); 
    text-decoration: none; 
    font-size: 13px; 
    transition: color 0.3s;
    padding-right: 15px;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }
  .footer-legal-links li:last-child a { border-right: none; padding-right: 0; }
  .footer-legal-links a:hover { color: #fff; }

  /* --- RESPONSIVE --- */
  @media (max-width: 992px) {
    .footer-links-grid { grid-template-columns: repeat(2, 1fr); gap: 40px; }
    .footer-bottom-grid { flex-direction: column; text-align: center; }
    .footer-bottom-right { justify-content: center; }
  }

  @media (max-width: 768px) {
    .footer-top-grid { flex-direction: column; text-align: center; }
    .localization-wrapper { justify-content: center; }
    .footer-legal-links { flex-wrap: wrap; justify-content: center; }
    .footer-legal-links a { border-right: none; padding: 0 10px; }
  }

  @media (max-width: 480px) {
    .footer-modern .container { padding: 0 20px; }
    .footer-links-grid { grid-template-columns: 1fr; text-align: center; gap: 30px; }
    .footer-heading::after { left: 50%; transform: translateX(-50%); }
    .footer-menu a:hover { padding-left: 0; color: #fff; }
  }
{% endstylesheet %}

{% schema %}
