{%- if section.settings.show_announcement -%}
  <div class="dark-glass-announcement-bar">
    <a href="{{ section.settings.link | default: '#' }}" class="dark-glass-announcement-link">
      <div class="marquee-container" style="--scroll-speed: {{ section.settings.speed }}s;">
        <p class="marquee-text">{{ section.settings.text }}</p>
        <p class="marquee-text" aria-hidden="true">{{ section.settings.text }}</p>
        <p class="marquee-text" aria-hidden="true">{{ section.settings.text }}</p>
        <p class="marquee-text" aria-hidden="true">{{ section.settings.text }}</p>
      </div>
    </a>
  </div>

  <style>
    /* --- La barre noire façon verre fumé (Smoked Glass) --- */
    .dark-glass-announcement-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 40px;
      display: flex;
      align-items: center;
      
      /* Le secret du verre fumé : fond noir semi-transparent + gros flou */
      background: rgba(0, 0, 0, 0.45); 
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      z-index: 1002;
      overflow: hidden; 
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }
    
    .dark-glass-announcement-link {
      text-decoration: none !important;
      display: block;
      width: 100%;
    }

    /* --- Le conteneur du texte défilant --- */
    .marquee-container {
      display: flex;
      width: max-content;
      animation: marqueeScroll var(--scroll-speed) linear infinite;
    }

    /* Pause l'animation au survol de la souris */
    .marquee-container:hover {
      animation-play-state: paused;
    }

    /* --- Le style du texte --- */
    .marquee-text {
      color: {{ section.settings.text_color | default: '#ffffff' }};
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin: 0;
      padding-right: 80px; 
      font-family: 'Inter', sans-serif;
      white-space: nowrap;
    }

    /* --- L'animation de défilement --- */
    @keyframes marqueeScroll {
      0% {
        transform: translateX(0);
      }
      100% {
        /* On recule exactement d'un quart (25%) car on a 4 phrases identiques */
        transform: translateX(-25%);
      }
    }
    
    /* Pousse automatiquement le menu principal vers le bas */
    .mainNav {
      top: 40px !important;
    }
    
    /* Ajustement de l'espacement global du corps de la page */
    body {
      padding-top: 40px;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free expedited shipping for your upcoming trip to Amsterdam! ✈️"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner Link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "sec",
      "label": "Scrolling Speed",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}