<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ page_description | escape }}">
    
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% render 'css-variables' %}

    <style>
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}

      {%- assign heading_font_bold = settings.type_heading_font | font_modify: 'weight', 'bold' -%}
      {%- assign heading_font_italic = settings.type_heading_font | font_modify: 'style', 'italic' -%}
      {%- assign heading_font_bold_italic = heading_font_bold | font_modify: 'style', 'italic' -%}
      
      {%- assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold' -%}
      {%- assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic' -%}
      {%- assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic' -%}

      {{ heading_font_bold | font_face: font_display: 'swap' }}
      {{ heading_font_italic | font_face: font_display: 'swap' }}
      {{ heading_font_bold_italic | font_face: font_display: 'swap' }}

      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}

      :root {
        --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --font-heading-weight: {{ settings.type_heading_font.weight }};
        
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
      }

      .skip-to-content-link:not(:focus) {
        border: 0;
        clip: rect(0 0 0 0);
        height: 1px;
        margin: -1px;
        overflow: hidden;
        padding: 0;
        position: absolute;
        width: 1px;
      }
      .skip-to-content-link:focus {
        padding: 1rem;
        position: absolute;
        z-index: 9999;
        background-color: var(--color-background);
        color: var(--color-foreground);
      }
    </style>

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'glass-button.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'cart-notification.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'meta-tags' %}
    {{ content_for_header }}
  </head>

  {%- capture body_styles -%}
    {%- if template == 'index' -%}
      --bg-color: {{ settings.home_bg_color }};
      {% if settings.home_bg_image %}--bg-image: url('{{ settings.home_bg_image | image_url: width: 1200 }}');{% endif %}
    {%- elsif template.name == 'product' -%}
      --bg-color: {{ settings.global_product_bg_color }};
      {% if settings.global_product_bg_image %}--bg-image: url('{{ settings.global_product_bg_image | image_url: width: 1200 }}');{% endif %}
    {%- elsif template.name == 'cart' -%}
      --bg-color: {{ settings.global_cart_bg_color }};
      {% if settings.global_cart_bg_image %}--bg-image: url('{{ settings.global_cart_bg_image | image_url: width: 1200 }}');{% endif %}
    {%- elsif template.name == 'collection' -%}
      --bg-color: {{ settings.global_collection_bg_color }};
      {% if settings.global_collection_bg_image %}--bg-image: url('{{ settings.global_collection_bg_image | image_url: width: 1200 }}');{% endif %}
    {%- elsif template.name == 'list-collections' -%}
      --bg-color: {{ settings.global_list_collections_bg_color }};
      {% if settings.global_list_collections_bg_image %}--bg-image: url('{{ settings.global_list_collections_bg_image | image_url: width: 1200 }}');{% endif %}
    {%- elsif template.name == 'search' -%}
      --bg-color: {{ settings.global_search_bg_color }};
      {% if settings.global_search_bg_image %}--bg-image: url('{{ settings.global_search_bg_image | image_url: width: 1200 }}');{% endif %}
    {%- endif -%}
  {%- endcapture -%}

  <body style="{{ body_styles }}">
    <a class="skip-to-content-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% section 'announcement-bar' %}
    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" style="padding: 0; margin: 0;" tabindex="-1">
      {{ content_for_layout }}
      {% sections 'footer-group' %}
    </main>

    <div id="CartNotification" class="cart-notification">
      <div class="notification-content">
        <span class="success-icon">✓</span>
        <p>{{ 'cart.general.added_to_cart' | t }}</p>
      </div>
      <a href="{{ routes.cart_url }}" class="btn-view-cart">{{ 'cart.general.view_cart' | t }}</a>
      <button id="CloseNotification" class="close-btn">✕</button>
    </div>

    <script defer src="{{ 'cart-notification.js' | asset_url }}"></script>
    
    {% section 'newsletter-popup' %}
  </body>
</html>